import tkinter as tk
from tkinter import ttk, messagebox
import socket
import threading
from concurrent.futures import ThreadPoolExecutor

# Global flag for stopping the scan
is_scanning = False

def scan_port(target_ip, port):
    global is_scanning
    if not is_scanning:
        return
        
    try:
        # AF_INET = IPv4, SOCK_STREAM = TCP
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(0.5) # Fast timeout for rapid scanning
        
        # connect_ex returns 0 if successful (port open), or an error code if closed
        result = sock.connect_ex((target_ip, port))
        
        if result == 0:
            try:
                # Attempt to resolve common service names (e.g., 80 -> http)
                service = socket.getservbyport(port, "tcp")
            except OSError:
                service = "Unknown"
                
            insert_log(f"[+] Port {port:5} | TCP | OPEN | {service.upper()}\n", "success")
            
        sock.close()
    except Exception:
        pass

def start_scan():
    global is_scanning
    target = entry_target.get().strip()
    
    try:
        start_port = int(entry_start.get().strip())
        end_port = int(entry_end.get().strip())
    except ValueError:
        messagebox.showerror("Input Error", "Ports must be valid integers.")
        return
        
    if not target:
        messagebox.showerror("Input Error", "Please enter a target IP or domain.")
        return
        
    if start_port < 1 or end_port > 65535 or start_port > end_port:
        messagebox.showerror("Input Error", "Invalid port range. Must be between 1 and 65535.")
        return

    # Resolve hostname to IP
    try:
        target_ip = socket.gethostbyname(target)
    except socket.gaierror:
        messagebox.showerror("Network Error", "Could not resolve target hostname.")
        return

    is_scanning = True
    btn_scan.config(state=tk.DISABLED)
    btn_stop.config(state=tk.NORMAL)
    text_output.config(state=tk.NORMAL)
    text_output.delete(1.0, tk.END)
    text_output.insert(tk.END, f"[*] Initiating TCP Scan against {target} ({target_ip})\n")
    text_output.insert(tk.END, f"[*] Scanning ports {start_port} through {end_port}...\n")
    text_output.insert(tk.END, "-" * 55 + "\n")
    text_output.config(state=tk.DISABLED)
    
    lbl_status.config(text="Scan in progress...", fg="#e67e22")
    
    # Run the executor in a background thread to keep Tkinter responsive
    threading.Thread(target=execute_threads, args=(target_ip, start_port, end_port), daemon=True).start()

def execute_threads(target_ip, start_port, end_port):
    global is_scanning
    
    # ThreadPoolExecutor handles the concurrency pool automatically
    with ThreadPoolExecutor(max_workers=200) as executor:
        for port in range(start_port, end_port + 1):
            if not is_scanning:
                break
            executor.submit(scan_port, target_ip, port)
            
    if is_scanning:
        insert_log("-" * 55 + "\n[*] Port scan complete.\n")
        root.after(0, lambda: lbl_status.config(text="Scan Complete", fg="#27ae60"))
    else:
        insert_log("-" * 55 + "\n[!] Scan aborted by user.\n", "error")
        root.after(0, lambda: lbl_status.config(text="Aborted", fg="#c0392b"))
        
    root.after(0, reset_ui)

def reset_ui():
    btn_scan.config(state=tk.NORMAL)
    btn_stop.config(state=tk.DISABLED)

def stop_scan():
    global is_scanning
    is_scanning = False
    lbl_status.config(text="Halting threads...", fg="#c0392b")

def insert_log(message, tag=None):
    text_output.config(state=tk.NORMAL)
    if tag:
        text_output.insert(tk.END, message, tag)
    else:
        text_output.insert(tk.END, message)
    text_output.see(tk.END)
    text_output.config(state=tk.DISABLED)

# --- Tkinter GUI Layout ---
root = tk.Tk()
root.title("SOC Toolkit - TCP Port Scanner")
root.geometry("600x520")
root.resizable(False, False)

frame = ttk.Frame(root, padding="15")
frame.pack(fill=tk.BOTH, expand=True)

lbl_title = tk.Label(frame, text="Multi-Threaded TCP Port Scanner", font=("Helvetica", 13, "bold"))
lbl_title.pack(anchor="w", pady=(0, 5))

lbl_desc = tk.Label(frame, text="Maps external attack surfaces by initiating concurrent TCP socket connections.", font=("Helvetica", 9), fg="#555")
lbl_desc.pack(anchor="w", pady=(0, 15))

# Configuration
config_frame = tk.Frame(frame)
config_frame.pack(fill=tk.X, pady=(0, 15))

tk.Label(config_frame, text="Target IP/Domain:", font=("Helvetica", 9, "bold")).grid(row=0, column=0, sticky="w", pady=5)
entry_target = ttk.Entry(config_frame, width=25, font=("Consolas", 10))
entry_target.grid(row=0, column=1, padx=(10, 20), pady=5, sticky="w")
entry_target.insert(0, "127.0.0.1") 

tk.Label(config_frame, text="Port Range:", font=("Helvetica", 9, "bold")).grid(row=0, column=2, sticky="w", pady=5)
entry_start = ttk.Entry(config_frame, width=6, font=("Consolas", 10), justify="center")
entry_start.grid(row=0, column=3, padx=(5, 5))
entry_start.insert(0, "1")

tk.Label(config_frame, text="-").grid(row=0, column=4)

entry_end = ttk.Entry(config_frame, width=6, font=("Consolas", 10), justify="center")
entry_end.grid(row=0, column=5, padx=(5, 0))
entry_end.insert(0, "1024")

# Controls
control_frame = tk.Frame(frame)
control_frame.pack(fill=tk.X, pady=(10, 10))

btn_scan = tk.Button(control_frame, text="Start Scan", command=start_scan, bg="#2980b9", fg="white", font=("Helvetica", 9, "bold"), width=12)
btn_scan.pack(side=tk.LEFT, padx=(0, 10))

btn_stop = tk.Button(control_frame, text="Stop", command=stop_scan, bg="#c0392b", fg="white", font=("Helvetica", 9, "bold"), width=10, state=tk.DISABLED)
btn_stop.pack(side=tk.LEFT)

lbl_status = tk.Label(control_frame, text="Ready", font=("Consolas", 9), fg="#7f8c8d")
lbl_status.pack(side=tk.RIGHT, padx=(0, 5))

# Output Console
text_frame = tk.Frame(frame)
text_frame.pack(fill=tk.BOTH, expand=True, pady=(0, 10))

scrollbar = tk.Scrollbar(text_frame)
scrollbar.pack(side=tk.RIGHT, fill=tk.Y)

text_output = tk.Text(text_frame, font=("Consolas", 10), bg="#1e1e1e", fg="#ecf0f1", yscrollcommand=scrollbar.set)
text_output.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
text_output.tag_config("success", foreground="#2ecc71", font=("Consolas", 10, "bold"))
text_output.tag_config("error", foreground="#e74c3c")
text_output.config(state=tk.DISABLED)

scrollbar.config(command=text_output.yview)

root.mainloop()